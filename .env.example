# Copy to .env locally and fill with values from your secret store.
# Never commit the populated file.

POSTGRES_PASSWORD=
REDIS_PASSWORD=
MEILI_MASTER_KEY=
SMTP_PASSWORD=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALLOW_EPHEMERAL=false
# Optional comma-separated reverse-proxy IPs/CIDRs, for example the actual
# Caddy-to-backend peer address. Leave empty to ignore forwarded IP headers.
BENETNASCH_TRUSTED_PROXIES=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash-vision-exp

ALIBAILIAN_API_KEY=
ALIBAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBAILIAN_MODEL=qwen3.7-text-embedding
ALIBAILIAN_MODEL2=qwen3.7-text-embedding-flash

# Optional deployment-time AI rollout overrides. Leave empty/false by default;
# invalid values fail closed. Only set these during an approved isolated or
# production release window.
BENETNASCH_AI_ENABLED=
BENETNASCH_AI_PROVIDER_PROBE=
BENETNASCH_AI_LOCAL_EMBEDDING=false
BENETNASCH_AI_VISION=
BENETNASCH_AI_ARTICLE_INDEXING=
BENETNASCH_AI_OBSERVABILITY=false
# Internal Companion bridge: disabled by default. Use separate random tokens
# for read and publish; never put them in YAML or a request body.
BENETNASCH_AI_SPACE_COMPANION=false
BENETNASCH_AI_SPACE_COMPANION_PUBLISH=false
BENETNASCH_SPACE_COMPANION_READ_TOKEN=
BENETNASCH_SPACE_COMPANION_PUBLISH_TOKEN=
BENETNASCH_SPACE_COMPANION_AGENT_ID=moonfei
