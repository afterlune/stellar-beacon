# Public DNS must point both names at this Docker host. Do not add a scheme.
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com

# Generate separate strong values (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value
MEILI_MASTER_KEY=replace-with-a-long-random-value

# SMTP provider credentials are required for account verification and notices.
SMTP_HOST=smtp.example.com
SMTP_EMAIL=blog@example.com
SMTP_PORT=465
SMTP_PASSWORD=replace-with-an-app-password

# MinIO is enabled with --profile minio. The same credentials are used by the
# application and MinIO; change them before the first deployment.
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=stellar-beacon
OBJECT_STORAGE_PUBLIC_URL=https://example.com/storage/stellar-beacon
OBJECT_STORAGE_PUBLIC_READ=true
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-a-unique-storage-access-key
OBJECT_STORAGE_ACCESS_KEY_SECRET=replace-with-a-long-random-value
