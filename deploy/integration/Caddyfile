{
    auto_https off
}

:80 {
    handle_path /api {
        reverse_proxy https://backend:7777 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    handle_path /api/* {
        reverse_proxy https://backend:7777 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    handle {
        root * /srv/vue/blog
        try_files {path} {path}/ /index.html
        file_server
        encode gzip zstd
    }
}

:8008 {
    handle_path /api {
        reverse_proxy https://backend:7777 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    handle_path /api/* {
        reverse_proxy https://backend:7777 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    handle {
        root * /srv/vue/admin
        try_files {path} {path}/ /index.html
        file_server
        encode gzip zstd
    }
}
