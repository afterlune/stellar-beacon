{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "docker-compose"],
  "schedule": ["before 5am on monday"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "postgres",
        "redis",
        "caddy",
        "getmeili/meilisearch",
        "alpine"
      ],
      "automerge": false,
      "pinDigests": false
    }
  ]
}
